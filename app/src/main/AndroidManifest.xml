<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    android:versionCode="1"
    android:versionName="1.1.2">

    <!-- Needed for the "Vibrate on Keypress" setting - without this, Vibrator.vibrate()
         throws a SecurityException on every call. It's caught in vibrate()'s try/catch,
         so it fails completely silently: the toggle stays on and no error ever shows,
         it just never actually buzzes. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name="com.ola.keyboard.OlaKeyboardApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="false"
        android:theme="@style/Theme.fox">
        <activity
            android:name="com.ola.keyboard.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="com.ola.keyboard.MainActivity"
            android:exported="false" />
        <activity
            android:name="com.ola.keyboard.DonateActivity"
            android:exported="false"
            android:parentActivityName="com.ola.keyboard.MainActivity" />
        <activity
            android:name="com.ola.keyboard.PredictionManagerActivity"
            android:exported="false"
            android:parentActivityName="com.ola.keyboard.MainActivity" />
        <activity
            android:name="com.ola.keyboard.ClipsManagerActivity"
            android:exported="false"
            android:parentActivityName="com.ola.keyboard.MainActivity" />
        <activity
            android:name="com.ola.keyboard.UpdateActivity"
            android:exported="false"
            android:parentActivityName="com.ola.keyboard.MainActivity" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <service
            android:name="com.ola.keyboard.InputMethodService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>
    </application>
</manifest>
