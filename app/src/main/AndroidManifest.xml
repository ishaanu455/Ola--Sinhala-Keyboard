<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    android:versionCode="1"
    android:versionName="1.1.2">

    <!-- Needed only to download the optional Twemoji-style emoji image pack chosen in Settings.
         The app still works fully offline with the default (Mobile/System) emoji style. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="false"
        android:theme="@style/Theme.fox">
        <activity
            android:name="unicode.sinhala.keyboard.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="unicode.sinhala.keyboard.DonateActivity"
            android:exported="false"
            android:parentActivityName="unicode.sinhala.keyboard.MainActivity" />
        <activity
            android:name="unicode.sinhala.keyboard.PredictionManagerActivity"
            android:exported="false"
            android:parentActivityName="unicode.sinhala.keyboard.MainActivity" />
        <service
            android:name="unicode.sinhala.keyboard.InputMethodService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>
    </application>
</manifest>
