<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="6dp"
    android:layout_marginVertical="4dp">

    <LinearLayout
        android:id="@+id/clip_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_clip_card"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp">

        <TextView
            android:id="@+id/clip_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="18dp"
            android:maxLines="5"
            android:ellipsize="end"
            android:textSize="14sp"
            android:textColor="?attr/foreground"
            tools:text="Copied clip text goes here" />

        <LinearLayout
            android:id="@+id/clip_actions"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:gravity="end|center_vertical"
            android:visibility="gone">

            <ImageView
                android:id="@+id/clip_pin"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:padding="7dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_clip_pin"
                android:background="?android:selectableItemBackgroundBorderless"
                android:contentDescription="@string/clip_pin" />

            <ImageView
                android:id="@+id/clip_share"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:padding="7dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_clip_share"
                android:background="?android:selectableItemBackgroundBorderless"
                android:contentDescription="@string/clip_share" />

            <ImageView
                android:id="@+id/clip_delete"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:padding="7dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_clip_delete"
                android:background="?android:selectableItemBackgroundBorderless"
                android:contentDescription="@string/clip_delete" />

        </LinearLayout>

    </LinearLayout>

    <!-- Small purple pin badge, shown only on pinned clips -->
    <ImageView
        android:id="@+id/clip_pin_badge"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_gravity="top|end"
        android:layout_margin="6dp"
        android:padding="4dp"
        android:background="@drawable/bg_clip_purple_circle"
        android:src="@drawable/ic_clip_pin"
        android:tint="@android:color/white"
        android:scaleType="centerInside"
        android:visibility="gone"
        android:contentDescription="@string/clip_pin" />

    <!-- Selection checkbox badge - visible on every clip while multi-select delete mode
         is active. Shows an empty outline circle when not selected (bg/icon swapped in
         code) and a filled purple circle with a checkmark once selected, so it's clear
         up front which clips can be picked instead of only showing feedback afterward. -->
    <ImageView
        android:id="@+id/clip_select_check"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_gravity="top|start"
        android:layout_margin="6dp"
        android:padding="3dp"
        android:background="@drawable/bg_clip_select_empty"
        android:scaleType="centerInside"
        android:visibility="gone"
        android:contentDescription="@string/clip_selected" />

</FrameLayout>
