                    android:layout_weight="1"
                    android:background="@drawable/key_background_action"
                    android:padding="4dp"
                    android:scaleType="centerInside" />

            </LinearLayout>
        </LinearLayout>

        <include
            android:id="@+id/emoji_view"
            layout="@layout/emoji_layout"
            android:visibility="gone" />

        <include
            android:id="@+id/clipboard_view"
            layout="@layout/clipboard_layout"
            android:visibility="gone" />

        <include
            android:id="@+id/text_select_view"
            layout="@layout/text_select_layout"
            android:visibility="gone" />

        <include
            android:id="@+id/font_style_view"
            layout="@layout/font_style_layout"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>