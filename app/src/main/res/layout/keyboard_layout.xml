                    android:layout_weight="1"
                    android:tag="44"
                    android:text=","
                    android:visibility="gone"
                    android:background="@drawable/key_background_function"/>

                <com.ola.keyboard.KeyboardButton
                    android:id="@+id/dot"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
