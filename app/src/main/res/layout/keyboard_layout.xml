                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:tag="7"
                    android:text="7" />

                <com.ola.keyboard.KeyboardButton
                    android:id="@+id/n_8"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:tag="8"
                    android:text="8" />

                <com.ola.keyboard.KeyboardButton
                    android:id="@+id/n_9"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:tag="9"
                    android:text="9" />

                <com.ola.keyboard.KeyboardButton
