                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:tag="s1"
                    android:text="/"
                    android:visibility="gone"
                    android.background="@drawable/key_background_function"/>

                <com.ola.keyboard.KeyboardButton
                    android:id="@+id/comma"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:tag="44"
                    android:text=","
                    android:background="@drawable/key_background_function"/>

                <ImageView
                    android:id="@+id/space"
                    android:layout_width="48dp"
                    android:layout_height="match_parent"
                    android:layout_weight="3"
                    android:background="@drawable/key_background_action"
                    android:padding="4dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_space_bar"
                    android:tag=" " />

                <com.ola.keyboard.KeyboardButton
                    android:id="@+id/comma_wijesekara"
                    android:layout_width="0dp"
