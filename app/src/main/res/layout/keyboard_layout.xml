<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/fox_background"
    android:orientation="vertical"
    android:paddingStart="2dp"
    android:paddingEnd="2dp"
    android:paddingTop="2dp"
    android:paddingBottom="8dp"
    tools:ignore="HardcodedText,ContentDescription">

    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:background="?attr/fox_background"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <include
            android:id="@+id/suggestionContainer"
            layout="@layout/suggestion_container"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <!-- Every icon after this point uses @style/TopBarIcon, which owns the
             size and the 4dp marginStart gap. That's the "professional spacing"
             mechanism: to add icon #4, #5, #6, #7 later (e.g. the cursor-mode
             toggle), just drop in another ImageView with style="@style/TopBarIcon"
             here - the gap to its neighbour is automatic, no per-icon margin
             tuning needed, and the row will hold up to 7 icons at this size
             within a standard keyboard width. -->
        <LinearLayout
            android:id="@+id/top_bar_icon_row"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Ola brand mark, always the very first icon in the row. Purely a
                 branding badge (no tint, full-color logo on its own circular
                 background) - not part of the clipboard/emoji/fonts back-arrow
                 group below. -->
            <ImageView
                android:id="@+id/btn_ola_logo"
                style="@style/TopBarIcon"
                android:layout_marginStart="0dp"
                android:background="@null"
                android:src="@drawable/ic_ola_logo_mark"
                android:contentDescription="@string/app_name"/>

            <!-- Pinned to the very start of the clipboard/emoji/fonts group. Doubles
                 as the clipboard panel's back arrow (see KeyboardView.kt
                 toggleClipboardView) - it never changes position, only its
                 icon/content-description. -->
            <ImageView
                android:id="@+id/btn_clipboard"
                style="@style/TopBarIcon"
                android:src="@drawable/ic_clipboard"
                android:tint="?attr/foreground"
                android:contentDescription="@string/clipboard_title"/>

            <!-- Visible only while the clipboard panel is open: an expanding
                 spacer that pushes btn_clip_clear all the way to the opposite
                 corner from the fixed back arrow above. top_bar_icon_row itself
                 is switched to width=0dp/weight=1 at the same time so this
                 spacer has room to actually expand into. -->
            <Space
                android:id="@+id/clipboard_row_spacer"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:visibility="gone" />

            <!-- Same purple circular treatment as btn_clip_clear, right next to it.
                 Opens the "Filter clips" dropdown (see KeyboardView.kt showClipFilterMenu). -->
            <ImageView
                android:id="@+id/btn_clip_filter"
                style="@style/TopBarIcon"
                android:background="@drawable/bg_clip_purple_circle"
                android:src="@drawable/ic_clip_filter"
                android:tint="@android:color/white"
                android:visibility="gone"
                android:contentDescription="@string/clip_filter_title" />

            <ImageView
                android:id="@+id/btn_clip_clear"
                style="@style/TopBarIcon"
                android:background="@drawable/bg_clip_purple_circle"
                android:src="@drawable/ic_clip_delete"
                android:tint="@android:color/white"
                android:visibility="gone"
                android:contentDescription="@string/clipboard_clear" />

            <!-- Pinned right after the clipboard icon/spacer group. Doubles as
                 the emoji panel's back arrow (see KeyboardView.kt
                 toggleEmojiView) - it never changes position, only its
                 icon/content-description. -->
            <ImageView
                android:id="@+id/btn_emoji"
                style="@style/TopBarIcon"
                android:src="@drawable/ic_emoji"
                android:tint="?attr/foreground"/>

            <!-- Visible only while the emoji panel is open: the category tab
                 strip, moved onto the same line as the fixed back arrow above
                 instead of its own row inside emoji_layout.xml. Expands (via
                 top_bar_icon_row switching to width=0dp/weight=1) to fill the
                 rest of the line; its icons can be long-pressed and dragged to
                 reorder amongst themselves, while btn_emoji stays put. -->
            <HorizontalScrollView
                android:id="@+id/emoji_categories_scroll"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:visibility="gone"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/emoji_categories"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:paddingHorizontal="4dp" />

            </HorizontalScrollView>

            <ImageView
                android:id="@+id/btn_text_select"
                style="@style/TopBarIcon"
                android:src="@drawable/ic_text_select"
                android:tint="?attr/foreground"
                android:contentDescription="@string/text_select_title"/>

            <!-- Pinned last in the row. Doubles as the Fonts panel's back arrow
                 (see KeyboardView.kt toggleFontStyleView) - it never changes
                 position, only its icon/content-description. Gets a purple-circle
                 background (matching btn_clip_clear's treatment) while a style
                 other than "None" is active, so it's obvious at a glance without
                 opening the panel. -->
            <ImageView
                android:id="@+id/btn_fonts"
                style="@style/TopBarIcon"
                android:background="@drawable/bg_top_bar_icon_circle"
                android:src="@drawable/ic_fonts"
                android:tint="?attr/foreground"
                android:contentDescription="@string/font_style_title"/>

        </LinearLayout>

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recent_emoji_row"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:visibility="gone"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:scrollbars="none" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/keyboard_rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
