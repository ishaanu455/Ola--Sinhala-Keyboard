                    android:layout_weight="0.5" />

                <com.ola.keyboard.KeyboardButton
                    android:id="@+id/l_a"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:tag="a"
