                    android:layout_weight="1"
                    android:tag="k"
                    android:text="k" />

                <com.ola.keyboard.KeyboardButton
                    android:id="@+id/l_l"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:tag="l"
                    android:text="l" />

                <com.ola.keyboard.KeyboardButton
                    android:id="@+id/colon_wijesekara"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:tag="59"
                    android:text=";"
                    android:background="@drawable/key_background_function"
                    android:visibility="gone" />

                <View
                    android:id="@+id/blank_2"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="0.5" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/key_row_4"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/shift"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.5"
                    android:background="@drawable/key_background_function"
                    android:padding="8dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_shift" />

                <com.ola.keyboard.KeyboardButton
                    android:id="@+id/l_z"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:tag="z"
                    android:text="z" />

                <com.ola.keyboard.KeyboardButton
                    android:id="@+id/l_x"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
