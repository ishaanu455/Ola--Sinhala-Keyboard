                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:tag="1"
                    android:text="1" />

                <com.ola.keyboard.KeyboardButton
                    android:id="@+id/n_2"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:tag="2"
                    android:text="2" />

                <com.ola.keyboard.KeyboardButton
                    android:id="@+id/n_3"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:tag="3"
                    android:text="3" />

                <com.ola.keyboard.KeyboardButton
                    android:id="@+id/n_4"
                    android:layout_width="0dp"
