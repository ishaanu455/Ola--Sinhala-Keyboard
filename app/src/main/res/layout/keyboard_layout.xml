                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:tag="0"
                    android:text="0" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/key_row_2"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal">

                <com.ola.keyboard.KeyboardButton
                    android:id="@+id/l_q"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:tag="q"
                    android:text="q" />

                <com.ola.keyboard.KeyboardButton
                    android:id="@+id/l_w"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:tag="w"
                    android:text="w" />

                <com.ola.keyboard.KeyboardButton
                    android:id="@+id/l_e"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:tag="e"
                    android:text="e" />

                <com.ola.keyboard.KeyboardButton
                    android:id="@+id/l_r"
                    android:layout_width="0dp"
