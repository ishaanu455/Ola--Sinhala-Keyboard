<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- The old header row (back button / title / clear-all) was removed from here.
         Both actions now live in the keyboard's top_bar (see keyboard_layout.xml:
         btn_clipboard doubles as back, btn_clip_clear is the new trash icon), so the
         clipboard list gets the full panel height instead of losing 48dp to a second bar. -->

    <!-- BUG FIX: see emoji_layout.xml's identical note - this root's own opaque
         ?attr/fox_background used to hide binding.root's gradient/custom-photo
         background whenever this panel was open. Removed so it shows through. -->

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/clipboard_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="2dp"
            android:paddingBottom="6dp" />

        <TextView
            android:id="@+id/clipboard_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="24dp"
            android:gravity="center"
            android:text="@string/clipboard_empty"
            android:textSize="14sp"
            android:textColor="?attr/foreground_2"
            android:visibility="gone" />

    </FrameLayout>

</LinearLayout>
