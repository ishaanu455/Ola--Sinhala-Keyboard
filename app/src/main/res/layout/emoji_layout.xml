<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- BUG FIX: this root used to paint its own opaque ?attr/fox_background,
         which sits (via keyboard_layout.xml's <include>) directly on top of
         binding.root inside the same FrameLayout as keyboard_rows - so opening
         this panel always hid whatever binding.root was actually showing
         underneath (the gradient from applyGradientToKeyboard(), or the photo
         from renderCustomImageBackground()) behind a flat opaque colour,
         regardless of the selected background mode. No background here at all
         now, so root's background always shows through - for the plain flat
         theme this is visually identical (same ?attr/fox_background colour,
         just inherited instead of redrawn), and for gradient/custom-image mode
         the panel now actually shows it, matching the main keyboard view. -->

    <!-- The category tab strip used to live here as its own row. It now sits in
         keyboard_layout.xml's top_bar, on the same line as the back arrow (see
         KeyboardView.kt toggleEmojiView), so the grid gets that row's height
         back automatically. -->

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/emoji_grid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="4dp" />

    <LinearLayout
        android:id="@+id/emojiBottomBar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/btn_abc"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.5"
            android:background="@drawable/key_background_function"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_keyboard"
            android:contentDescription="Keyboard" />

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="7" />

        <ImageView
            android:id="@+id/btn_backspace"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.5"
            android:background="@drawable/key_background_function"
            android:contentDescription="@string/backspace"
            android:padding="14dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_backspace" />

    </LinearLayout>

</LinearLayout>