<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="unicodesinhala" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- General background and text -->
        <item name="fox_background">@color/keyboard_bg_light</item>
        <item name="accent">@color/accent_amber</item>
        <item name="foreground">@color/text_on_light</item>
        <item name="foreground_2">@color/text_on_light_variant</item>
        <item name="isLight">true</item>

        <!-- Key surfaces and borders -->
        <item name="border">@color/keyboard_bg_light</item>
        <item name="keyNormal">@color/keyboard_key_light</item>
        <item name="keyFunction">@color/keyboard_func_light</item>
        <item name="keyAction">@color/accent_amber</item>

        <!-- Pressed states -->
        <item name="keyNormalPressed">@color/keyboard_func_pressed_light</item>
        <item name="keyFunctionPressed">@color/keyboard_func_pressed_light</item>
        <item name="keyActionPressed">@color/accent_amber_pressed</item>
        <item name="keyShadowColor">#40000000</item>

        <!-- Special keys -->
        <item name="keySpecial">@color/keyboard_key_light</item>
        <item name="keySpecialPressed">@color/keyboard_func_pressed_light</item>

        <!-- Clipboard "Clips" card surface -->
        <item name="clipCard">@color/clip_card_light</item>
        <item name="clipCardPressed">@color/keyboard_func_pressed_light</item>
    </style>

    <style name="Theme.fox"
        parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="fox_background">@color/keyboard_bg_light</item>
        <item name="colorPrimary">@color/accent_amber</item>
        <item name="colorOnPrimary">@color/text_on_light</item>
        <item name="colorSurface">@color/keyboard_bg_light</item>
        <item name="colorOnSurface">@color/text_on_light</item>
        <item name="colorOnSurfaceVariant">@color/text_on_light_variant</item>
        <item name="preferenceTheme">@style/ThemeOverlay.fox.Preference</item>
    </style>

    <!-- Splash screen theme - sets the window background to the same dark ink
         color the Compose splash content uses, so there's no white system flash
         before setContent() draws (see SplashActivity.kt). -->
    <style name="Theme.Splash" parent="Theme.fox">
        <item name="android:windowBackground">@color/keyboard_bg_dark</item>
        <item name="android:statusBarColor">@color/keyboard_bg_dark</item>
        <item name="android:navigationBarColor">@color/keyboard_bg_dark</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="ThemeOverlay.fox.Preference"
        parent="PreferenceThemeOverlay">
        <item name="android:textColorPrimary">@color/text_on_light</item>
        <item name="android:textColorSecondary">@color/text_on_light_variant</item>
        <item name="colorControlActivated">@color/accent_amber</item>
    </style>

    <!-- Light fallback (pre-v31) -->
    <style name="Light" parent="unicodesinhala">
        <item name="isLight">true</item>
    </style>

    <style name="LightNoBorder" parent="Light">
        <item name="border">@android:color/transparent</item>
    </style>

    <!-- Night fallback (pre-v31) -->
    <style name="Night" parent="unicodesinhala">
        <item name="isLight">false</item>
        <!-- Override to dark tokens -->
        <item name="fox_background">@color/keyboard_bg_dark</item>
        <item name="foreground">@color/text_on_dark</item>
        <item name="foreground_2">@color/text_on_dark_variant</item>
        <item name="border">@color/keyboard_bg_dark</item>

        <!-- Keys -->
        <item name="keyNormal">@color/keyboard_key_dark</item>
        <item name="keyFunction">@color/keyboard_func_dark</item>
        <item name="keyAction">@color/accent_amber</item>

        <!-- Pressed states -->
        <item name="keyNormalPressed">@color/keyboard_func_pressed_dark</item>
        <item name="keyFunctionPressed">@color/keyboard_func_pressed_dark</item>
        <item name="keyActionPressed">@color/accent_amber_pressed</item>

        <!-- Clipboard "Clips" card surface -->
        <item name="clipCard">@color/clip_card_dark</item>
        <item name="clipCardPressed">@color/keyboard_func_pressed_dark</item>
    </style>

    <style name="NightNoBorder" parent="Night">
        <item name="border">@android:color/transparent</item>
    </style>

    <!-- Accent overlays for Appearance > Colour Themes. Layered on top of the
         Light/Dark/*NoBorder style via a second ContextThemeWrapper (see
         KeyboardView.kt), so each retints the whole key bed (background, key
         surfaces, pressed states, border) to the theme's hue - not just the
         Enter/Space accent - while keeping the exact same lightness structure
         as the neutral palette (bg lightest -> key -> func -> func_pressed
         darkest) so the key hierarchy still reads clearly; only the hue shifts.
         "Ola" (the brand default) needs no overlay since the base styles
         already use the amber palette. Split into Light/Dark pairs since key
         surface colors differ between the two - KeyboardView.kt picks the
         right one based on the current dark-theme setting. -->
    <style name="AccentWineLight">
        <item name="accent">@color/accent_wine</item>
        <item name="keyAction">@color/accent_wine</item>
        <item name="keyActionPressed">@color/accent_wine_pressed</item>
        <item name="fox_background">@color/wine_bg_light</item>
        <item name="border">@color/wine_bg_light</item>
        <item name="keyNormal">@color/wine_key_light</item>
        <item name="keyFunction">@color/wine_func_light</item>
        <item name="keyNormalPressed">@color/wine_func_pressed_light</item>
        <item name="keyFunctionPressed">@color/wine_func_pressed_light</item>
        <item name="keySpecial">@color/wine_key_light</item>
        <item name="keySpecialPressed">@color/wine_func_pressed_light</item>
        <item name="clipCard">@color/wine_func_light</item>
        <item name="clipCardPressed">@color/wine_func_pressed_light</item>
    </style>

