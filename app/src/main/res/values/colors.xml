<?xml version="1.0" encoding="utf-8"?>


<resources>
    <!-- Light / Neutral tokens -->
    <color name="light_1">#D9D9D9</color>
    <color name="light_2">#a6a6a6</color>

    <!-- Dark / Neutral tokens -->
    <color name="night_1">#262626</color>
    <color name="night_2">#595959</color>

    <!-- Text tokens (explicit, used by themes) -->
    <color name="text_on_light">#000000</color> <!-- black for light backgrounds -->
    <color name="text_on_light_variant">#222222</color>
    <color name="text_on_dark">#FFFFFF</color> <!-- white for dark backgrounds -->
    <color name="text_on_dark_variant">#E0E0E0</color>

    <!-- Physical keyboard key palette. Kept neutral/near-monochrome on purpose - a
         busy, colorful key bed is worse to type on, which is why every major keyboard
         (Gboard, SwiftKey, etc.) uses the same trick. What actually reads as "Ola" here
         is the warm cream/ink undertone (vs. Gboard's cool white/grey) and the amber
         action key below, not the neutral key surfaces themselves. -->
    <color name="keyboard_bg_light">#FBF8F2</color>        <!-- keyboard background (light) -->
    <color name="keyboard_key_light">#FFFFFF</color>       <!-- normal key (light) -->
    <color name="keyboard_func_light">#EFE9DC</color>      <!-- function key (light) -->
    <color name="keyboard_func_pressed_light">#E3DBC8</color>

    <color name="keyboard_bg_dark">#1C1B17</color>         <!-- keyboard background (dark) -->
    <color name="keyboard_key_dark">#26241E</color>        <!-- normal key (dark) -->
    <color name="keyboard_func_dark">#332F26</color>       <!-- function key (dark) -->
    <color name="keyboard_func_pressed_dark">#403A2C</color>

    <!-- Brand accent - amber. Used for the Enter/Go action key, active toggle states,
         and anywhere else on the physical keyboard that needs to stand out.
         This is also the default keyboard colour theme ("Ola"). -->
    <color name="accent_amber">#D4A24C</color>
    <color name="accent_amber_pressed">#B8853A</color>

    <!-- Additional keyboard colour themes (Appearance > Colour Themes). Deliberately
         muted/deep tones rather than flat primary red/black/blue, so they read as
         "professional" variants that match the rest of the app's design language. -->
    <color name="accent_wine">#8C3B4A</color>
    <color name="accent_wine_pressed">#713040</color>

    <color name="accent_slate">#46545C</color>
    <color name="accent_slate_pressed">#37424A</color>

    <color name="accent_ocean">#34597A</color>
    <color name="accent_ocean_pressed">#294764</color>

    <color name="accent_forest">#3F6B4A</color>
    <color name="accent_forest_pressed">#325A3C</color>

    <color name="accent_onyx">#2B2B2E</color>
    <color name="accent_onyx_pressed">#1C1C1E</color>

    <color name="accent_navy">#22385C</color>
    <color name="accent_navy_pressed">#182A45</color>

    <!-- Full key-surface palettes per colour theme (Appearance > Colour Themes).
         Same lightness structure as the neutral/amber palette above (bg lightest,
         then key, func, func_pressed darkening in the same steps) so key hierarchy
         reads identically across themes - only the hue changes, at a muted
         saturation, so it never turns into a flat single-colour keyboard. Wired
         into the AccentXxx style overlays below. -->
    <color name="wine_bg_light">#F8F5F6</color>
    <color name="wine_key_light">#FFFFFF</color>
    <color name="wine_func_light">#EBE0E2</color>
    <color name="wine_func_pressed_light">#DECDD0</color>
