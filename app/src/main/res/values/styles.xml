<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Shared style for every icon in the top bar (clipboard, emoji, clip-clear,
         and any future icon such as the cursor-mode toggle). Centralising the
         size/spacing here means the top bar can scale from 2 icons up to the
         7-icon max without each icon needing its own hand-tuned margin - just
         apply this style and the spacing stays even automatically.
         marginStart is deliberately modest (not the wider gap you'd use with only
         2-3 icons): with the logo + 5 functional icons, the row's minimum required
         width is already close to what many phones' *effective* dp-width offers
         once their own "Display size" system setting (which varies by phone brand
         even at "default") shrinks it - a bigger margin here was pushing the
         right-most icon (Settings) off the edge and clipping it on those phones. -->
    <style name="TopBarIcon">
        <item name="android:layout_width">38dp</item>
        <item name="android:layout_height">38dp</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:padding">6dp</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:background">@drawable/bg_top_bar_icon_circle</item>
        <!-- btn_clipboard is the first focusable view in the IME window, so on
             newer Android versions the system auto-assigns it "default focus"
             the moment the keyboard opens and draws its own square focus-highlight
             rectangle behind the round bg_top_bar_icon_circle background - that's
             the box artifact. This attribute (API 26+, silently ignored below
             that) turns that system rectangle off for every top-bar icon, while
             leaving the round pressed/normal states from bg_top_bar_icon_circle
             untouched. -->
        <item name="android:defaultFocusHighlightEnabled">false</item>
    </style>

</resources>
