<?xml version="1.0" encoding="utf-8"?>
<!-- Rounded panel behind the clip-filter dropdown, matching the clipboard
     cards' surface color plus a hairline border so it reads clearly against
     both light and dark keyboard themes. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="?attr/clipCard" />
    <stroke android:width="1dp" android:color="?attr/border" />
    <corners android:radius="14dp" />
</shape>
