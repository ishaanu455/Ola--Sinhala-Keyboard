<?xml version="1.0" encoding="utf-8"?>
<!-- Small solid-red dot shown on top of btn_settings when Prefs.updateAvailable is
     true (see KeyboardView.kt updateSettingsBadge()). A thin MattBlack ring around
     it keeps it visually separated from the gear icon underneath, same idea as a
     notification-dot outline on a launcher icon. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="#FF3B30" />
    <stroke
        android:width="1.5dp"
        android:color="#151515" />
</shape>
