<?xml version="1.0" encoding="utf-8"?>
<!-- Purple circular button background, matching the "Clips" screen's header icon buttons. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="@color/clip_accent_pressed" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/clip_accent" />
        </shape>
    </item>
</selector>
